cmd-stt_confirm-desc = Toggle review of recognized speech before it is sent to chat.
cmd-stt_confirm-help = stt_confirm [true|false]
cmd-stt_record-desc = Start or stop recording in the STT companion program.
cmd-stt_record-help = stt_record [true|false]
stt-confirm-on = Recognized speech will be placed in the chat input for review.
stt-confirm-off = Recognized speech will be sent to chat immediately.
stt-record-on = Recording requested.
stt-record-off = Recording stop requested.
