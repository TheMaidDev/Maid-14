eorstats-slippedcount-totalslips = The crew slipped { $timesSlipped } { $timesSlipped ->
    [one] time
   *[other] times
} this shift!
eorstats-slippedcount-none = The crew didn't slip a single time this shift!
eorstats-slippedcount-topslipper-hasusername = { $username } as { $name } was the clumsiest this shift and slipped { $slipcount } { $slipcount ->
    [one] time
   *[other] times
}!
eorstats-slippedcount-topslipper-hasnousername = { $name } was the clumsiest this shift and slipped { $slipcount } { $slipcount ->
    [one] time
   *[other] times
}!
