cmd-getreput-desc = Get player's reputation value.
cmd-getreput-help = Usage: getreput {$ckey}
cmd-getreput-not-enough-args = Not enough arguments.
cmd-getreput-player-not-found = Couldn't find player: {$ckey}.
cmd-getreput-failed = Couldn't get player's reputation.
cmd-getreput-result = Reputation of {$ckey}: {$value}

cmd-modifyreput-desc = Add the value to user's reputation.
cmd-modifyreput-help = Usage: modifyreput {$ckey} {$valueToAdd}
cmd-modifyreput-not-enough-args = Not enough arguments.
cmd-modifyreput-player-not-found = Couldn't find player: {$ckey}.
cmd-modifyreput-invalid-value = Invalid value: {$value}.
cmd-modifyreput-result = Added {$value} to the reputation of {$ckey}.

cmd-setreput-desc = Sets the reputation to the certain value.
cmd-setreput-help = Usage: setrep {$ckey} {$value}
cmd-setreput-not-enough-args = Not enough arguments.
cmd-setreput-player-not-found = Couldn't find player: {$ckey}.
cmd-setreput-invalid-value = Invalid value: {$value}.
cmd-setreput-result = Set reputation of {$ckey} to {$value}.

cmd-showreput-desc = Check your own reputation.
cmd-showreput-help = Usage: showreput
cmd-showreput-failed = Couldn't get reputation data.
cmd-showreput-result = Your reputation: {$value}
