#!/bin/bash

gitroot=`git rev-parse --show-toplevel`

cd "$gitroot/BuildChecker"

if [[ `uname` == MINGW* || `uname` == CYGWIN* ]]; then
    # Windows
    py -3 git_helper.py --quiet || true
else
    # Not Windows, so probably some other Unix thing.
    python3 git_helper.py --quiet || true
fi
exit 0
