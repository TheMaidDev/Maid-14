<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:animated="clr-namespace:Content.Client._Maid.UserInterface.AnimatedBackground"
    xmlns:maidControls="clr-namespace:Content.Client._Maid.Lobby.UI"
    xmlns:whiteButtons="clr-namespace:Content.Client._White.UserInterface.Buttons">
    <!-- Background -->
    <animated:AnimatedBackgroundControl Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background" /> <!-- Tweak-Maid: Animated Lobby -->
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Vertical"
                  Margin="10 10 10 10" SeparationOverride="2">
        <Control Name="DefaultState" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <!-- Top Panel -->
                <BoxContainer Name="TopSide" Orientation="Horizontal" HorizontalExpand="True" MinSize="0 40" MaxSize="Infinity 40">
                    <PanelContainer StyleClasses="TransparentBorderedWindowPanel" HorizontalExpand="True">
                        <!-- Top Button Bar -->
                        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3 3 3 3">
                            <info:LinkBanner Name="LinkBanner" VerticalExpand="True" />
                            <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}" />
                            <vote:VoteCallMenuButton Name="CallVoteButton" />
                            <Button Name="OptionsButton" Access="Public" Text="{Loc 'ui-lobby-options-button'}" />
                            <whiteButtons:CustomGhostsMenuOpenButton Name="CustomGhostsButton" Text="{Loc 'ui-lobby-custom-ghosts-button'}" />
                            <!-- MAID lobby layout -->
                            <Button Name="SwitchLayoutButton" Access="Public" Text="{Loc 'ui-lobby-switch-layout-button'}" />
                            <!-- MAID lobby layout end -->
                            <Button Name="LeaveButton" Access="Public" Text="{Loc 'ui-lobby-leave-button'}" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
                <!-- Voting Popups -->
                <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                              Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="20 60 0 0" />
                <!-- MAID BEGIN lobby layout -->
                <BoxContainer Name="WdLayout" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
                        <Control HorizontalExpand="True" />
                        <PanelContainer StyleClasses="TransparentBorderedWindowPanel" VerticalAlignment="Top"
                                        MinWidth="380" MaxWidth="480" Margin="0 8 0 0">
                            <maidControls:LobbyServerListBox Name="LobbyServerList" Margin="6 6 6 6" />
                        </PanelContainer>
                    </BoxContainer>
                    <BoxContainer Name="WdBottomSide" Orientation="Horizontal" HorizontalExpand="True"
                                  SeparationOverride="4" Margin="0 10 0 10">
                        <BoxContainer Name="WdCharacterSlot" MinWidth="300" MaxWidth="350" VerticalAlignment="Bottom">
                            <PanelContainer Name="CharacterPanel" StyleClasses="TransparentBorderedWindowPanel"
                                            HorizontalExpand="True" MinSize="0 100" Margin="0 0 2 0">
                                <!-- Character Preview & Preferences -->
                                <BoxContainer Orientation="Vertical">
                                    <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" HorizontalExpand="True" VerticalExpand="True" />
                                    <maidControls:CharacterPreferencesWidget Name="PreferencesWidget" Access="Public" HorizontalExpand="True" Margin="0 0 0 0"/>
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                        <BoxContainer Name="WdChatSlot" HorizontalExpand="True" SizeFlagsStretchRatio="3" VerticalAlignment="Bottom">
                            <!-- Chat -->
                            <PanelContainer Name="ChatPanel" Access="Public" StyleClasses="TransparentBorderedWindowPanel"
                                            HorizontalExpand="True" SetHeight="390" Margin="2 0 0 0">
                                <BoxContainer Name="ChatPanelBox" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                                              Margin="8 8 8 8">
                                    <Label Name="ServerName" Access="Public" StyleClasses="LabelHeadingBigger"
                                           VAlign="Center" HorizontalExpand="True" HorizontalAlignment="Center"
                                           Margin="0 0 0 10" />
                                    <controls:StripeBack Name="ButtonsStripe" Margin="0 0 0 10">
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="3 3 3 3">
                                            <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                                HorizontalAlignment="Left"
                                                                Text="{Loc 'ui-lobby-observe-button'}"
                                                                StyleClasses="ButtonBig"
                                                                WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                            <Label Name="StartTime" Access="Public" Align="Center"
                                                   FontColorOverride="{x:Static maths:Color.DarkGray}"
                                                   StyleClasses="LabelBig" HorizontalExpand="True"
                                                   Margin="0 0 0 5" />
                                            <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                                    HorizontalAlignment="Right"
                                                    Text="{Loc 'ui-lobby-ready-up-button'}"
                                                    StyleClasses="ButtonBig" MinWidth="137" />
                                        </BoxContainer>
                                    </controls:StripeBack>
                                    <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True"
                                                     Margin="3 3 3 3" />
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                        <!-- Server info -->
                        <PanelContainer Name="WdInfoPanel" StyleClasses="TransparentBorderedWindowPanel"
                                        HorizontalExpand="True" MinWidth="300" MaxWidth="450"
                                        VerticalAlignment="Bottom" Margin="2 0 2 0">
                            <BoxContainer Name="WdInfoBox" Orientation="Vertical" HorizontalExpand="True"
                                          Margin="8 8 8 8">
                                <info:ServerInfo Name="ServerInfo" Access="Public" MinSize="0 30"
                                                 VerticalExpand="false" Margin="3 3 3 3"
                                                 HorizontalAlignment="Left" />
                                <Label Name="StationTime" Access="Public"
                                       FontColorOverride="{x:Static maths:Color.LightGray}"
                                       Margin="3 3 3 10" HorizontalAlignment="Left" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
                <!-- Classic three-panel layout -->
                <BoxContainer Name="ClassicLayout" Visible="False" Orientation="Horizontal" VerticalAlignment="Bottom"
                              HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4" Margin="0 10 0 10">
                    <BoxContainer Name="ClassicCharacterSlot" HorizontalExpand="True" VerticalAlignment="Bottom" />
                    <PanelContainer Name="ClassicInfoPanel" StyleClasses="TransparentBorderedWindowPanel"
                                    HorizontalExpand="True" SetHeight="390" Margin="2 0 2 0">
                        <BoxContainer Name="ClassicInfoBox" Orientation="Vertical" HorizontalExpand="True"
                                      VerticalExpand="True" Margin="8 8 8 8" />
                    </PanelContainer>
                    <BoxContainer Name="ClassicChatSlot" HorizontalExpand="True" VerticalAlignment="Bottom" />
                </BoxContainer>
                <!-- MAID END lobby layout -->
            </BoxContainer>
        </Control>
        <!-- Character setup state -->
        <!-- This is injected on startup. Funky! -->
        <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
    </BoxContainer>
</lobbyUi:LobbyGui>
