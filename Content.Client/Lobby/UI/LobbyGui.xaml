<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:animated="clr-namespace:Content.Client._Maid.UserInterface.AnimatedBackground"
    xmlns:maidControls="clr-namespace:Content.Client._Maid.Lobby.UI"
    xmlns:neon="clr-namespace:Content.Client._Maid.UserInterface.Neon">
    <!-- Background -->
    <animated:AnimatedBackgroundControl Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background" /> <!-- Tweak-Maid: Animated Lobby -->
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Vertical"
                  Margin="8 8 8 8" SeparationOverride="2">
        <LayoutContainer Name="DefaultState" VerticalExpand="True" HorizontalExpand="True">
            <!-- Voting popups: overlaid on top-left, must NOT push the layout around -->
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                          Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- Always-visible HUD toggle (stays when the rest of the lobby UI is hidden). -->
            <TextureButton Name="HideUiButton" Access="Public"
                           TexturePath="/Textures/Interface/hamburger.svg.192dpi.png"
                           SetSize="24 24" ToolTip="{Loc 'ui-lobby-hide-ui-button'}" />
            <!-- Main 3-column layout, sized to survive 1280x720 -->
            <BoxContainer Name="BottomSide" Orientation="Horizontal" VerticalAlignment="Stretch"
                          HorizontalExpand="True" VerticalExpand="True"
                          SeparationOverride="6" Margin="0 6 0 6">

                    <!-- COLUMN 1: left menu -->
                    <neon:NeonFlickerControl MinSize="180 0" MaxSize="250 Infinity"
                                             Margin="36 16 0 0" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" MinSize="180 0" VerticalExpand="True"
                                      SeparationOverride="10">
                            <Control VerticalExpand="True" />
                            <neon:NeonFlickerControl Intensity="1.45">
                                <Label Text="Maid Cafe" StyleClasses="LobbyTitle" Margin="0 0 0 2" />
                            </neon:NeonFlickerControl>

                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <maidControls:ReadyStatusIcon Name="ReadyIcon" Access="Public" />
                                <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                        HorizontalAlignment="Left"
                                        Text="{Loc 'lobby-state-player-status-not-ready'}"
                                        StyleClasses="MenuTextButton" />
                            </BoxContainer>

                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="CharacterIcon" Access="Public"
                                             TexturePath="/Textures/Interface/character.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <Button Name="MenuCharacterSetupButton" Text="{Loc 'ui-lobby-character-setup-button'}"
                                        StyleClasses="MenuTextButton" HorizontalAlignment="Left" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="RulesIcon" Access="Public"
                                             TexturePath="/Textures/Interface/students-cap.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <Button Name="MenuRulesButton" Text="{Loc 'ui-lobby-rules-guidebook-button'}"
                                        StyleClasses="MenuTextButton" HorizontalAlignment="Left" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="OptionsIcon" Access="Public"
                                             TexturePath="/Textures/Interface/Nano/gear.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <Button Name="OptionsButton" Access="Public" Text="{Loc 'ui-lobby-options-button'}"
                                        StyleClasses="MenuTextButton" HorizontalAlignment="Left" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="DiscordIcon" Access="Public"
                                             TexturePath="/Textures/Interface/VerbIcons/open.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <Button Name="MenuDiscordButton" Access="Public" Text="{Loc 'rmc-ui-link-discord-account'}"
                                        StyleClasses="MenuTextButton" HorizontalAlignment="Left" />
                            </BoxContainer>

                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="ObserveIcon" Access="Public"
                                             TexturePath="/Textures/Interface/VerbIcons/light.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                    HorizontalAlignment="Left"
                                                    Text="{Loc 'ui-lobby-observe-button'}"
                                                    StyleClasses="MenuTextButton"
                                                    WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                            </BoxContainer>

                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="AHelpIcon" Access="Public"
                                             TexturePath="/Textures/Interface/VerbIcons/light.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                        HorizontalAlignment="Left" StyleClasses="MenuTextButton" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" SeparationOverride="8">
                                <TextureRect Name="LeaveIcon" Access="Public"
                                             TexturePath="/Textures/Interface/VerbIcons/eject.svg.192dpi.png"
                                             SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                                <Button Name="LeaveButton" Access="Public" Text="{Loc 'ui-lobby-leave-button'}"
                                        StyleClasses="MenuTextButton" HorizontalAlignment="Left" />
                            </BoxContainer>

                            <Control VerticalExpand="True" />
                            <BoxContainer Name="HiddenCharacterArea" Visible="False" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" HorizontalExpand="True" VerticalExpand="True" />
                                <maidControls:CharacterPreferencesWidget Name="PreferencesWidget" Access="Public" HorizontalExpand="True" Margin="0 0 0 0"/>
                            </BoxContainer>
                        </BoxContainer>
                    </neon:NeonFlickerControl>

                    <Control HorizontalExpand="True" />

                    <!-- COLUMN 2: changelog -->
                    <neon:NeonFlickerControl Name="ChangelogColumn" Access="Public" Intensity="0.85" VerticalExpand="True">
                        <PanelContainer Name="ChangelogPanel" Access="Public"
                                        StyleClasses="TransparentBorderedWindowPanel"
                                        SetWidth="414" Margin="0 0 0 0" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                                          Margin="6 4 6 6" SeparationOverride="0">
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 4">
                                    <Label Text="{Loc 'ui-lobby-changelog-heading'}" StyleClasses="LobbyHeading"
                                           HorizontalExpand="True" HorizontalAlignment="Center" />
                                    <TextureButton Name="ToggleChangelogButton" Access="Public"
                                                   TexturePath="/Textures/Interface/Nano/cross.svg.png"
                                                   SetSize="16 16" VerticalAlignment="Center"
                                                   ToolTip="{Loc 'ui-lobby-toggle-changelog-button'}" />
                                </BoxContainer>
                                <PanelContainer Name="ChangelogBodyPanel" Access="Public"
                                                VerticalExpand="True" HorizontalExpand="True">
                                    <ScrollContainer Name="ChangelogScrollContainer" Access="Public"
                                                     VerticalExpand="True" HorizontalExpand="True"
                                                     HScrollEnabled="False" ReserveScrollbarSpace="False">
                                        <BoxContainer Orientation="Vertical" Name="ChangelogBodyContainer" Access="Public"
                                                      HorizontalExpand="True" Margin="0 0 8 0" />
                                    </ScrollContainer>
                                </PanelContainer>
                            </BoxContainer>
                        </PanelContainer>
                    </neon:NeonFlickerControl>

                    <!-- COLUMN 3: server info + chat -->
                    <neon:NeonFlickerControl Intensity="0.85" MinSize="414 0" MaxSize="414 Infinity" VerticalExpand="True">
                        <PanelContainer StyleClasses="TransparentBorderedWindowPanel"
                                        SetWidth="414" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                                          SeparationOverride="4">
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True"
                                              Margin="10 8 10 4" SeparationOverride="2">
                                    <maidControls:LobbyBracketHeading Text="{Loc 'ui-lobby-server-info-block'}"
                                                                      HorizontalAlignment="Left" />
                                    <Label Name="ServerName" Access="Public" StyleClasses="LobbyText"
                                           HorizontalAlignment="Left" ClipText="True" Margin="0 2 0 0" />
                                    <info:ServerInfo Name="ServerInfo" Access="Public" StyleClasses="LobbyText"
                                                     MinSize="0 20" VerticalExpand="false"
                                                     HorizontalAlignment="Left" Margin="0 2 0 2" />
                                    <Label Name="StationTime" Access="Public" StyleClasses="LobbyText"
                                           FontColorOverride="#E090C0"
                                           HorizontalAlignment="Left" />
                                    <Label Name="StartTime" Access="Public" StyleClasses="LobbyText"
                                           FontColorOverride="#E090C0"
                                           HorizontalAlignment="Left" Margin="0 0 0 2" />
                                </BoxContainer>
                                <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True"
                                                 HorizontalExpand="True"
                                                 MinSize="0 180" Margin="0 0 0 0" />
                            </BoxContainer>
                        </PanelContainer>
                    </neon:NeonFlickerControl>
                </BoxContainer>
            <!-- Track title/artist caption removed: credits already live in the audio files.
            <RichTextLabel Name="LobbySong" Access="Public" StyleClasses="LobbyVersion"
                           HorizontalAlignment="Left" MaxWidth="380" Visible="False" />
            -->
            <TextureButton Name="ShowChangelogButton" Access="Public" Visible="False"
                           TexturePath="/Textures/Interface/Changelog/plus.svg.192dpi.png"
                           SetSize="20 20" ToolTip="{Loc 'ui-lobby-show-changelog-button'}" />
        </LayoutContainer>
        <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
    </BoxContainer>
</lobbyUi:LobbyGui>
