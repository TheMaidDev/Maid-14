<ui:FancyWindow xmlns="https://spacestation14.io"
                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                SetSize="400 420" MinSize="360 380" Title="{Loc 'maid-music-ui-title'}">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Name="CassetteLabel" />
        <Label Name="NowPlayingLabel" />
        <BoxContainer Name="TrackList" Orientation="Vertical" Margin="0 4 0 0" />
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
            <Button Name="StopButton" Text="{Loc 'maid-music-ui-stop'}" HorizontalExpand="True" />
            <CheckBox Name="RepeatBox" Text="{Loc 'maid-music-ui-repeat'}" />
        </BoxContainer>
        <Label Text="{Loc 'maid-music-ui-record-header'}" Margin="0 12 0 0" />
        <LineEdit Name="NameField" PlaceHolder="{Loc 'maid-music-ui-name-placeholder'}" />
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
            <Button Name="ChooseButton" Text="{Loc 'maid-music-ui-choose'}" HorizontalExpand="True" />
            <Button Name="UploadButton" Text="{Loc 'maid-music-ui-record'}" HorizontalExpand="True" />
        </BoxContainer>
        <Label Name="FileLabel" Margin="0 4 0 0" />
        <Label Name="StatusLabel" />
    </BoxContainer>
</ui:FancyWindow>
