<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'extraction-device-ui-title'}"
               MinSize="580 600"
               SetSize="580 640">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="4">
        <!-- objectives group: status block and objectives block -->
        <PanelContainer StyleClasses="MaidTexturedBackground" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 0 6">
            <BoxContainer Orientation="Vertical" Margin="6" VerticalExpand="True">
                <PanelContainer StyleClasses="MaidTransparentBackground" HorizontalExpand="True" Margin="0 0 0 6">
                    <BoxContainer Orientation="Vertical" Margin="8 6">
                        <RichTextLabel Name="StatusLabel" HorizontalExpand="True" />
                        <RichTextLabel Name="ProgressLabel" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="MaidTransparentBackground" HorizontalExpand="True" VerticalExpand="True" MinSize="0 140">
                    <BoxContainer Orientation="Vertical" Margin="8 6" VerticalExpand="True">
                        <Label Text="{Loc 'extraction-device-ui-objectives-header'}" StyleClasses="LabelHeading" />
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <BoxContainer Name="ObjectivesList" Orientation="Vertical" HorizontalExpand="True" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>
        <!-- extraction group: zone, pod and code block, re-assignments block -->
        <PanelContainer StyleClasses="MaidTexturedBackground" HorizontalExpand="True" Margin="0 0 0 6">
            <BoxContainer Orientation="Vertical" Margin="6">
                <PanelContainer StyleClasses="MaidTransparentBackground" HorizontalExpand="True" Margin="0 0 0 6">
                    <BoxContainer Orientation="Vertical" Margin="8 6">
                        <RichTextLabel Name="ZoneLabel" HorizontalExpand="True" />
                        <RichTextLabel Name="PodLabel" HorizontalExpand="True" />
                        <RichTextLabel Name="CodeLabel" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="MaidTransparentBackground" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="8 6">
                        <RichTextLabel Name="RerollsLabel" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>
        <!-- controls: each button keeps at least its own text width -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
            <Button Name="RefreshButton" Access="Public" Text="{Loc 'extraction-device-ui-refresh'}" MinSize="110 34" />
            <Button Name="ZoneButton" Access="Public" Text="{Loc 'extraction-device-ui-zone'}" MinSize="200 34" HorizontalExpand="True" />
            <Button Name="PodButton" Access="Public" Text="{Loc 'extraction-device-ui-pod'}" MinSize="170 34" HorizontalExpand="True" StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
